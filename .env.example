# copy this to .env when running without docker. compose sets these on its own.

REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1
DATABASE_URL=postgresql+psycopg://payflow:payflow@localhost:5432/payflow

# retry / reliability settings, details in app/config.py
VISIBILITY_TIMEOUT=3600
MAX_RETRIES=5
RETRY_BACKOFF_MAX=600
IDEMPOTENCY_LEASE_SECONDS=900
STUCK_PAYOUT_SECONDS=600

# fake gateway. bump the failure rate to see retries + DLQ in action,
# set to 0 if you just want a clean run
GATEWAY_FAILURE_RATE=0.25
GATEWAY_LATENCY_MS=300
# GATEWAY_SEED=42        # fixed seed = same failures every run

TIMEZONE=Asia/Kolkata
